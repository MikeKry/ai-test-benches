new file mode 100644
index 000000000..1e95a5d77
--- /dev/null
+++ b/src/OrchardCore/OrchardCore.ContentManagement.GraphQL/Queries/IIndexPropertyValueNormalizer.cs
@@ -0,0 +1,23 @@
+namespace OrchardCore.ContentManagement.GraphQL.Queries;
+
+/// <summary>
+/// Normalizes the values a GraphQL <c>where</c> argument compares with an index property, so that
+/// the comparison matches how the property is stored (for instance lower-cased culture codes).
+/// </summary>
+public interface IIndexPropertyValueNormalizer
+{
+    /// <summary>
+    /// The index alias the property belongs to, as registered by an <see cref="IIndexAliasProvider"/>.
+    /// </summary>
+    string IndexAlias { get; }
+
+    /// <summary>
+    /// Returns <see langword="true"/> when <paramref name="propertyName"/> is normalized by this instance.
+    /// </summary>
+    bool CanNormalize(string propertyName);
+
+    /// <summary>
+    /// Normalizes a single value.
+    /// </summary>
+    object Normalize(object value);
+}
