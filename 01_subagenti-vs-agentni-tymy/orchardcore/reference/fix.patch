+
+    // Culture codes are stored lower case (see LocalizedContentItemIndexProvider); records indexed
+    // before that are converted so that case-sensitive databases find them.
+    public static int UpdateFrom4()
+    {
+        ShellScope.AddDeferredTask(async scope =>
+        {
+            var store = scope.ServiceProvider.GetRequiredService<IStore>();
+            var dbConnectionAccessor = scope.ServiceProvider.GetRequiredService<IDbConnectionAccessor>();
+            var configuration = store.Configuration;
+            var dialect = configuration.SqlDialect;
+            var table = dialect.QuoteForTableName(configuration.TablePrefix + nameof(LocalizedContentItemIndex), configuration.Schema);
+            var culture = dialect.QuoteForColumnName(nameof(LocalizedContentItemIndex.Culture));
+
+            await using var connection = dbConnectionAccessor.CreateConnection();
+            await connection.OpenAsync();
+            await using var transaction = await connection.BeginTransactionAsync(configuration.IsolationLevel);
+            await using var command = connection.CreateCommand();
+            command.Transaction = transaction;
+            command.CommandText = $"UPDATE {table} SET {culture} = LOWER({culture}) WHERE {culture} IS NOT NULL";
+            await command.ExecuteNonQueryAsync();
+            await transaction.CommitAsync();
+        });
+
+        return 5;
+    }
 }
