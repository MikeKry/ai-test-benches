+using OrchardCore.ContentManagement.GraphQL.Queries;
+
+namespace OrchardCore.ContentLocalization.GraphQL;
+
+/// <summary>
+/// Culture codes are stored lower case in <see cref="Records.LocalizedContentItemIndex"/>, so the values
+/// of a GraphQL filter on the culture are lower-cased too. This keeps the filter case-insensitive on
+/// every database, whatever its collation.
+/// </summary>
+public sealed class CultureIndexPropertyValueNormalizer : IIndexPropertyValueNormalizer
+{
+    public string IndexAlias => "localizationPart";
+
+    public bool CanNormalize(string propertyName)
+        => string.Equals(propertyName, nameof(Records.LocalizedContentItemIndex.Culture), StringComparison.OrdinalIgnoreCase);
+
+    public object Normalize(object value)
+        => value is string culture ? culture.ToLowerInvariant() : value;
+}
