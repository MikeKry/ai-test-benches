# Copy to config.env (git-ignored) and adjust. Plain KEY=VALUE lines, no shell syntax.
# Variables already set in the environment take precedence over this file.

# --- Benchmark settings (all optional, defaults shown) ---
# Use the same model in every mode.
BENCH_MODEL=sonnet
BENCH_MAX_TURNS=300
# Per-run timeout in seconds (a full OrchardCore build and test run takes a while).
BENCH_TIMEOUT=7200
# Path to the claude binary if it is not on PATH.
#CLAUDE_BIN=claude
# Headless runs cannot answer permission prompts. If a mode stalls on one, use
#BENCH_CLAUDE_FLAGS=--dangerously-skip-permissions
# (only in an isolated environment: the agent may then run any command).

# --- OrchardCore ---
# Local clone of https://github.com/OrchardCMS/OrchardCore and the commit every run starts from.
#BENCH_UPSTREAM=/path/to/OrchardCore
#BENCH_BASE_COMMIT=c5583e57dc675b9581231bbb6c4e8bd1ed91c845
# Docker image for the PostgreSQL pass of the hidden tests; leave empty to skip that pass.
#BENCH_POSTGRES_IMAGE=postgres:17
#BENCH_WORKDIR=/path/for/workspaces
#BENCH_RESULTS_DIR=/path/for/results

# --- One API key per mode (optional) ---
# Lets you attribute usage to a mode in your provider's own usage view. Without them runs use
# your current login.
KEY_SINGLE=
KEY_SUBAGENTS=
KEY_TEAM=
